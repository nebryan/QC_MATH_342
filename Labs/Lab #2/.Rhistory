colnames(num_errors_by_sepal_length) = c("threshold_param", "num_errors")
y_logical = set_and_vers$Species == "versicolor"
for(i in 1:n){
threshold = set_and_vers$Sepal.Length[i]
num_errors = sum((set_and_vers$Sepal.Length > threshold) != y_logical)
num_errors_by_sepal_length[i, ] = c(threshold, num_errors)
}
num_errors_by_sepal_length
#look at all thresholds in order
num_errors_by_sepal_length[order(num_errors_by_sepal_length[, "num_errors"]), ]
#now grab the smallest num errors
best_row = order(num_errors_by_sepal_length[, "num_errors"])[1]
sepal_length_star = c(num_errors_by_sepal_length[best_row, "threshold_param"], use.names = FALSE)
sepal_length_star
threshold
summary(iris[iris$Species == "setosa", "Sepal.Length"])
summary(iris[iris$Species == "versicolor", "Sepal.Length"])
g = function(x){
factor(ifelse(x > sepal_length_star, "virginica", "setosa"), levels = c("virginica", "setosa"))
}
g(3.5)
g(7.2)
set_and_vers$Sepal.Length > threshold
y_logical
sepal_length_star
#now grab the smallest num errors
best_row = order(num_errors_by_sepal_length[, "num_errors"])[1]
#now grab the smallest num errors
best_row = order(num_errors_by_sepal_length[, "num_errors"])[1]
sepal_length_star = c(num_errors_by_sepal_length[best_row, "threshold_param"], use.names = FALSE)
